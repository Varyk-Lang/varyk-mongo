}

struct Nicked {
    name: string,
    nick: Option<string>,
}

#[test]
async fn a_dollar_string_value_stays_text() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_dollar_string_value_stays_text");
            assert(cleared(c).await);
            let people = vec![Aged { name: "$secret", age: 1 }, Aged { name: "Ada", age: 36 }];
            assert(c.insert_many(people).await.is_ok());
            assert_eq(shown(c.count("{ name: ? }", "$secret").await), "1");
            let matched: Result<Vec<Aged>, Error> = c.aggregate("[{ $match: { name: ? } }]", "$secret").await;
            match matched {
                Ok(found) => {
                    let ages: Vec<i32> = found.iter().map(|p| p.age).collect();
                    assert_eq(ages, vec![1]);
                }
                Err(e) => assert_eq(e.message(), "no error"),
            }
            // `$name` would be Ada's name were it read as a field path.
            assert_eq(shown(c.update("{ name: 'Ada' }", "{ $set: { nick: ? } }", "$name").await), "1");
            assert_eq(shown(c.update("{ name: '$secret' }", "{ $set: { nick: ? } }", "$secret").await), "1");
            let ada: Result<Nicked, Error> = c.one("{ name: 'Ada' }").await;
            match ada {
                Ok(p) => assert(p.nick == Some("$name")),
                Err(e) => assert_eq(e.message(), "no error"),
            }
            assert_eq(shown(c.count("{ nick: '$secret' }").await), "1");
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

struct Session {
    token: string,
}

struct Account {
    name: string,
    sessions: Vec<Session>,
}

#[test]
async fn a_none_value_cannot_be_matched_and_set_stores_it_as_null() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_none_value_cannot_be_matched_and_set_stores_it_as_null");
            assert(cleared(c).await);
            let ada = Account { name: "Ada", sessions: vec![Session { token: "t1" }, Session { token: "t2" }] };
            assert(c.insert(ada).await.is_ok());
            let none: Option<string> = None;
            assert_eq(shown(c.count("{ reset_token: ? }", none).await), "value 1, at character 16 of the filter text: a `None` value cannot be matched; write `null` in the text to match a missing or null field");
            assert_eq(shown(c.update("{ name: ? }", "{ $pull: { sessions: { token: ? } } }", "Ada", none).await), "value 2, at character 31 of the update text: a `None` value cannot be matched; write `null` in the text to match a missing or null field");
            let matched: Result<Vec<Named>, Error> = c.aggregate("[{ $match: { name: ? } }]", none).await;
            assert_eq(listed(matched), "value 1, at character 20 of the pipeline text: a `None` value cannot be matched; write `null` in the text to match a missing or null field");
            let kept: Result<Account, Error> = c.one("{ name: 'Ada' }").await;
            match kept {
                Ok(a) => assert_eq(a.sessions.len(), 2),
                Err(e) => assert_eq(e.message(), "no error"),
            }
            assert_eq(shown(c.update("{ name: ? }", "{ $set: { nick: ? } }", "Ada", none).await), "1");
            assert_eq(shown(c.count("{ nick: { $type: 'null' } }").await), "1");
            let nicked: Result<Nicked, Error> = c.one("{ name: 'Ada' }").await;
            match nicked {
                Ok(p) => assert(!p.nick.is_some()),
                Err(e) => assert_eq(e.message(), "no error"),
            }
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

struct Signup {
    email: string,
    at: Time,
}

#[test]
async fn create_index_twice_an_unknown_option_and_a_value_in_its_texts() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("create_index_twice_an_unknown_option_and_a_value_in_its_texts");
            assert(cleared(c).await);
            assert_eq(answered(c.create_index("{ email: 1 }", "{ unique: true }").await), "true");
            assert_eq(answered(c.create_index("{ email: 1 }", "{ unique: true }").await), "true");
            assert_eq(answered(c.create_index("{ at: 1 }", "{ expireAfterSeconds: 3600, name: 'signup_ttl', sparse: true }").await), "true");
            let ada = Signup { email: "ada@example.com", at: Time::now() };
            assert(c.insert(ada).await.is_ok());
            let again: Result<string, Error> = c.insert(ada).await;
            match again {
                Ok(_) => assert(false),
                Err(e) => {
                    assert(e.message().starts_with("E11000 duplicate key error"));
                    assert(e.message().contains("email_1"));
                }
            }
            assert_eq(answered(c.create_index("{ email: 1 }", "{ uniq: true }").await), "`uniq` is not an index option; the options are `unique`, `name`, `sparse`, and `expireAfterSeconds`");
            assert_eq(answered(c.create_index("{ email: 1 }", "{ unique: 'yes' }").await), "the index option `unique` takes `true` or `false`");
            assert_eq(answered(c.create_index("{ email: 1 }", "{ name: 1 }").await), "the index option `name` takes a quoted string");
            assert_eq(answered(c.create_index("{ at: 1 }", "{ expireAfterSeconds: -1 }").await), "the index option `expireAfterSeconds` takes a whole number of seconds from 0 up");
            assert(refused(answered(c.create_index("{ email: ? }", "{}").await), "the index keys text, at character 10:"));
            assert(refused(answered(c.create_index("{ email: 1 }", "{ name: ? }").await), "the index options text, at character 9:"));
            // The same keys with other options are the server's error.
            let other = answered(c.create_index("{ email: 1 }", "{ unique: false }").await);
            assert(other.contains("(code "));
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

struct Converted {
    whole: i64,
}

struct Halved {
    half: i64,
}

struct Exact {
    exact: string,
}

#[test]
async fn an_update_pipelines_conversions_read_back() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("an_update_pipelines_conversions_read_back");
            assert(cleared(c).await);
            let three = Numbered { n: 3 };
            assert(c.insert(three).await.is_ok());
            assert_eq(shown(c.update("{ n: 3 }", "[{ $set: { whole: { $toDouble: '$n' }, half: { $divide: ['$n', 2] }, exact: { $toDecimal: '$n' } } }]").await), "1");
            assert_eq(shown(c.count("{ whole: { $type: 'double' }, half: { $type: 'double' }, exact: { $type: 'decimal' } }").await), "1");
            let whole: Result<Converted, Error> = c.one("{}").await;
            match whole {
                Ok(doc) => assert_eq(doc.whole, 3),
                Err(e) => assert_eq(e.message(), "no error"),
            }
            let half: Result<Halved, Error> = c.one("{}").await;
            match half {
                Ok(_) => assert(false),
                Err(e) => {
                    assert(e.message().contains("`half`"));
                    assert(e.message().contains("fractional"));
                    assert(!e.message().contains("1.5"));
                }
            }
            let exact: Result<Exact, Error> = c.one("{}").await;
            match exact {
                Ok(doc) => assert_eq(doc.exact, "3"),
                Err(e) => assert_eq(e.message(), "no error"),
            }
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

#[test]
async fn the_values_of_an_update_fill_its_filter_and_then_its_update() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("the_values_of_an_update_fill_its_filter_and_then_its_update");
            assert(cleared(c).await);
            let ada = Aged { name: "Ada", age: 36 };
            assert(c.insert(ada).await.is_ok());
            assert_eq(shown(c.update("{ name: ? }", "{ $set: { age: ? } }", "Ada").await), "this call's texts take 2 values, one for each `?`, but 1 value was given");
            assert_eq(shown(c.update("{ name: ? }", "{ $set: { age: ? } }", "Ada", 40, 41).await), "this call's texts take 2 values, one for each `?`, but 3 values were given");
            assert_eq(shown(c.update_many("{ name: 'Ada' }", "{ $set: { age: ? } }").await), "this call's texts take 1 value, one for each `?`, but 0 values were given");
            assert_eq(answered(c.upsert("{ name: ? }", "{ $set: { age: 1 } }").await), "this call's texts take 1 value, one for each `?`, but 0 values were given");
            assert_eq(shown(c.delete("{ name: ? }").await), "this call's texts take 1 value, one for each `?`, but 0 values were given");
            let counted: Result<Vec<Named>, Error> = c.aggregate("[{ $match: { name: ? } }]").await;
            assert_eq(listed(counted), "this call's texts take 1 value, one for each `?`, but 0 values were given");
            assert_eq(shown(c.update("{}", "{ name: ? }", "x").await), "the update text, at character 3: each top-level key of an update starts with `$`, as `$set`; `replace` is the call for a whole document");
            assert_eq(shown(c.count("{ age: 36 }").await), "1");
            assert_eq(shown(c.update("{ name: ? }", "{ $set: { name: ?, age: ? } }", "Ada", "Ada Lovelace", 40).await), "1");
            let found: Result<Aged, Error> = c.one("{}").await;
            match found {
                Ok(p) => {
                    assert_eq(p.name, "Ada Lovelace");
                    assert_eq(p.age, 40);
                }
                Err(e) => assert_eq(e.message(), "no error"),
            }
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

// The number of ids an `insert_many` gave, as text, or its message when
// it failed.
fn added(result: Result<Vec<string>, Error>) -> string {
    match result {
        Ok(ids) => format!("{}", ids.len()),
        Err(e) => e.message().clone(),
    }
}

// The message of an `insert` that should fail, or "no error" when it did
// not.
fn inserted(result: Result<string, Error>) -> string {
    match result {
        Ok(_) => "no error",
        Err(e) => e.message().clone(),
    }
}

// What a transaction running every call of a collection saw: through
// its collections, and outside it before `commit`.
struct EveryCall {
    ids: usize,
    upserted: bool,
    replaced: bool,
    deleted: u64,
    deleted_many: u64,
    inside: u64,
    outside: u64,
    alan: i32,
    missing: bool,
    ages: Vec<i32>,
    grown: Vec<string>,
    committed: bool,
}

// Runs every call of a collection inside one transaction and commits it.
async fn every_call_in_a_transaction(db: crate::Database) -> Result<EveryCall, Error> {
    let mut tx = db.begin().await?;
    let c = tx.collection("a_transaction_runs_every_call_and_commits");
    let outside = db.collection("a_transaction_runs_every_call_and_commits");
    let id = Uuid::new();
    let ada = Person { id: id, name: "Ada", age: 36 };
    let _ada = c.insert(ada).await?;
    let more = vec![Aged { name: "Alan", age: 41 }, Aged { name: "Grace", age: 45 }, Aged { name: "Linus", age: 50 }];
    let ids = c.insert_many(more).await?;
    let _ada_aged = c.update("{ name: ? }", "{ $set: { age: ? } }", "Ada", 37).await?;
    let _older = c.update_many("{ age: { $gt: ? } }", "{ $inc: { age: 1 } }", 40).await?;
    let upserted = c.upsert("{ name: ? }", "{ $set: { age: ? } }", "Edsger", 72).await?;
    let renamed = Person { id: id, name: "Ada Lovelace", age: 37 };
    let replaced = c.replace(renamed).await?;
    let deleted = c.delete("{ name: ? }", "Linus").await?;
    let deleted_many = c.delete_many("{ name: ? }", "Edsger").await?;
    let inside = c.count("{}").await?;
    let seen = outside.count("{}").await?;
    let alan: Aged = c.one("{ name: ? }", "Alan").await?;
    let nobody: Option<Aged> = c.first("{ name: 'Nobody' }").await?;
    let sorted: Vec<Aged> = c.find("{}").sort("{ age: 1 }").all().await?;
    let grown: Vec<Aged> = c.aggregate("[{ $match: { age: { $gte: ? } } }, { $sort: { name: 1 } }]", 40).await?;
    let committed = tx.commit().await?;
    Ok(EveryCall {
        ids: ids.len(),
        upserted: upserted,
        replaced: replaced,
        deleted: deleted,
        deleted_many: deleted_many,
        inside: inside,
        outside: seen,
        alan: alan.age,
        missing: !nobody.is_some(),
        ages: sorted.iter().map(|p| p.age).collect(),
        grown: grown.iter().map(|p| p.name.clone()).collect(),
        committed: committed,
    })
}

#[test]
async fn a_transaction_runs_every_call_and_commits() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_transaction_runs_every_call_and_commits");
            assert(cleared(c).await);
            let ran: Result<EveryCall, Error> = every_call_in_a_transaction(db).await;
            match ran {
                Ok(seen) => {
                    assert_eq(seen.ids, 3);
                    assert(seen.upserted);
                    assert(seen.replaced);
                    assert_eq(seen.deleted, 1);
                    assert_eq(seen.deleted_many, 1);
                    assert_eq(seen.inside, 3);
                    // Nothing shows outside the transaction before `commit`.
                    assert_eq(seen.outside, 0);
                    assert_eq(seen.alan, 42);
                    assert(seen.missing);
                    assert_eq(seen.ages, vec![37, 42, 46]);
                    assert_eq(seen.grown, vec!["Alan", "Grace"]);
                    assert(seen.committed);
                }
                Err(e) => assert_eq(e.message(), "no error"),
            }
            assert_eq(shown(c.count("{}").await), "3");
            assert_eq(shown(c.count("{ name: 'Ada Lovelace', age: 37 }").await), "1");
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

// What a second `commit`, and a call on a committed transaction's
// collection, give.
struct AfterCommit {
    committed: bool,
    again: string,
    call: string,
    insert: string,
    empty: string,
}

// Commits a transaction with one insert, then commits it again and calls
// its collection.
async fn commit_twice_and_call(db: crate::Database) -> Result<AfterCommit, Error> {
    let mut tx = db.begin().await?;
    let c = tx.collection("a_committed_transaction_is_finished");
    let ada = Aged { name: "Ada", age: 36 };
    let _ada = c.insert(ada).await?;
    let committed = tx.commit().await?;
    let again = answered(tx.commit().await);
    let call = shown(c.count("{}").await);
    let alan = Aged { name: "Alan", age: 41 };
    let insert = inserted(c.insert(alan).await);
    let nobody: Vec<Aged> = vec![];
    let empty = added(c.insert_many(nobody).await);
    Ok(AfterCommit { committed: committed, again: again, call: call, insert: insert, empty: empty })
}

#[test]
async fn a_committed_transaction_is_finished() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_committed_transaction_is_finished");
            assert(cleared(c).await);
            let ran: Result<AfterCommit, Error> = commit_twice_and_call(db).await;
            match ran {
                Ok(after) => {
                    assert(after.committed);
                    assert_eq(after.again, "this transaction is finished");
                    assert_eq(after.call, "this transaction is finished");
                    assert_eq(after.insert, "this transaction is finished");
                    assert_eq(after.empty, "this transaction is finished");
                }
                Err(e) => assert_eq(e.message(), "no error"),
            }
            assert_eq(shown(c.count("{}").await), "1");
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

// Inserts `person` in a transaction and drops the transaction without
// `commit`.
async fn insert_and_drop(db: crate::Database, person: Person) -> Result<string, Error> {
    let tx = db.begin().await?;
    let c = tx.collection("a_dropped_transaction_rolls_back_at_once");
    c.insert(person).await
}

#[test]
async fn a_dropped_transaction_rolls_back_at_once() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_dropped_transaction_rolls_back_at_once");
            assert(cleared(c).await);
            let id = Uuid::new();
            let ada = Person { id: id, name: "Ada", age: 36 };
            assert_eq(inserted(insert_and_drop(db, ada).await), "no error");
            assert_eq(shown(c.count("{}").await), "0");
            // An open transaction holding the `_id` would make this insert
            // wait for it, up to the server's 60-second limit.
            let started = Time::now();
            let again = Person { id: id, name: "Ada", age: 36 };
            assert_eq(inserted(c.insert(again).await), "no error");
            let waited = Time::now().to_unix_micros() - started.to_unix_micros();
            assert(waited < 10000000);
            assert_eq(shown(c.count("{}").await), "1");
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

// What a transaction gives after one of its calls failed on the server.
struct AfterFailure {
    failure: string,
    later: string,
    empty: string,
    commit: string,
    again: string,
    after: string,
}

// Inserts a document and then a duplicate of `taken`'s `_id` in one
// transaction, and goes on after the failure.
async fn fail_and_commit(db: crate::Database, taken: Uuid) -> Result<AfterFailure, Error> {
    let mut tx = db.begin().await?;
    let c = tx.collection("a_failed_transaction_rolls_back_at_commit");
    let grace = Aged { name: "Grace", age: 45 };
    let _grace = c.insert(grace).await?;
    let duplicate = Person { id: taken, name: "Ada", age: 36 };
    let failure = inserted(c.insert(duplicate).await);
    let later = shown(c.count("{}").await);
    let nobody: Vec<Aged> = vec![];
    let empty = added(c.insert_many(nobody).await);
    let commit = answered(tx.commit().await);
    let again = answered(tx.commit().await);
    let after = shown(c.count("{}").await);
    Ok(AfterFailure { failure: failure, later: later, empty: empty, commit: commit, again: again, after: after })
}

#[test]
async fn a_failed_transaction_rolls_back_at_commit() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_failed_transaction_rolls_back_at_commit");
            assert(cleared(c).await);
            let id = Uuid::new();
            let ada = Person { id: id, name: "Ada", age: 36 };
            assert_eq(inserted(c.insert(ada).await), "no error");
            let ran: Result<AfterFailure, Error> = fail_and_commit(db, id).await;
            match ran {
                Ok(after) => {
                    assert(after.failure.starts_with("E11000 duplicate key error"));
                    assert(after.failure.contains("(code 11000); the transaction will roll back"));
                    assert_eq(after.later, "a call in this transaction failed; it will roll back");
                    assert_eq(after.empty, "a call in this transaction failed; it will roll back");
                    assert_eq(after.commit, "the transaction was rolled back: a call in it failed");
                    assert_eq(after.again, "this transaction is finished");
                    assert_eq(after.after, "this transaction is finished");
                }
                Err(e) => assert_eq(e.message(), "no error"),
            }
            // Grace's insert rolled back with the transaction.
            assert_eq(shown(c.count("{}").await), "1");
            assert_eq(shown(c.count("{ name: 'Grace' }").await), "0");
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

fn dollar_replacement() -> string {
    "a replacement document cannot start with a key that begins with `$`, which MongoDB reads as an update; `update` is the call for that"
}

async fn dollar_replacement_in_a_transaction(db: crate::Database) -> Result<string, Error> {
    let mut tx = db.begin().await?;
    let c = tx.collection("a_replacement_starting_with_a_dollar_key_is_refused");
    let mut doc: HashMap<string, string> = HashMap::new();
    doc.insert("$set", "x");
    let refused = answered(c.replace(doc).await);
    let ada = Aged { name: "Ada", age: 36 };
    let _ada = c.insert(ada).await?;
    let committed = tx.commit().await?;
    if committed {
        return Ok(refused);
    }
    Ok("not committed")
}

#[test]
async fn a_replacement_starting_with_a_dollar_key_is_refused() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_replacement_starting_with_a_dollar_key_is_refused");
            assert(cleared(c).await);
            let mut doc: HashMap<string, string> = HashMap::new();
            doc.insert("$set", "x");
            assert_eq(answered(c.replace(doc).await), dollar_replacement());
            let ran: Result<string, Error> = dollar_replacement_in_a_transaction(db).await;
            match ran {
                Ok(refused) => assert_eq(refused, dollar_replacement()),
                Err(e) => assert_eq(e.message(), "no error"),
            }
            assert_eq(shown(c.count("{}").await), "1");
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

// The package's own errors inside a transaction, and its `commit` after
// them.
struct PackageErrors {
    missing: string,
    not_an_operator: string,
    empty: string,
    counted: string,
    none_added: string,
    committed: bool,
}

// Makes the package's own errors inside a transaction, between two
// inserts, and commits.
async fn package_errors_in_a_transaction(db: crate::Database) -> Result<PackageErrors, Error> {
    let mut tx = db.begin().await?;
    let c = tx.collection("a_package_error_inside_a_transaction_leaves_it_usable");
    let ada = Aged { name: "Ada", age: 36 };
    let _ada = c.insert(ada).await?;
    let nobody: Result<Aged, Error> = c.one("{ name: 'Nobody' }").await;
    let missing = match nobody {
        Ok(_) => "no error",
        Err(e) => e.message().clone(),
    };
    let not_an_operator = shown(c.update("{}", "{ name: ? }", "x").await);
    let empty = shown(c.update("{}", "{}").await);
    let counted = shown(c.count("{ name: ? }").await);
    let nobody: Vec<Aged> = vec![];
    let none_added = added(c.insert_many(nobody).await);
    let alan = Aged { name: "Alan", age: 41 };
    let _alan = c.insert(alan).await?;
    let committed = tx.commit().await?;
    Ok(PackageErrors { missing: missing, not_an_operator: not_an_operator, empty: empty, counted: counted, none_added: none_added, committed: committed })
}

#[test]
async fn a_package_error_inside_a_transaction_leaves_it_usable() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_package_error_inside_a_transaction_leaves_it_usable");
            assert(cleared(c).await);
            let ran: Result<PackageErrors, Error> = package_errors_in_a_transaction(db).await;
            match ran {
                Ok(seen) => {
                    assert_eq(seen.missing, "no document matches the filter; to read one that may be missing, use `first`");
                    assert_eq(seen.not_an_operator, "the update text, at character 3: each top-level key of an update starts with `$`, as `$set`; `replace` is the call for a whole document");
                    assert_eq(seen.empty, "the update text, at character 1: an update names at least one operator, as `$set`");
                    assert_eq(seen.counted, "this call's texts take 1 value, one for each `?`, but 0 values were given");
                    assert_eq(seen.none_added, "0");
                    assert(seen.committed);
                }
                Err(e) => assert_eq(e.message(), "no error"),
            }
            assert_eq(shown(c.count("{}").await), "2");
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

// What two transactions updating one document give.
struct Conflict {
    clash: string,
    later: string,
    committed: bool,
    rolled_back: string,
}

// Updates Ada in one transaction, then in a second while the first is
// open, and commits both.
async fn two_transactions_on_one_document(db: crate::Database) -> Result<Conflict, Error> {
    let mut first = db.begin().await?;
    let mut second = db.begin().await?;
    let a = first.collection("two_transactions_on_one_document_conflict");
    let b = second.collection("two_transactions_on_one_document_conflict");
    let _first = a.update("{ name: 'Ada' }", "{ $set: { age: 37 } }").await?;
    let clash = shown(b.update("{ name: 'Ada' }", "{ $set: { age: 38 } }").await);
    let later = shown(b.count("{}").await);
    let committed = first.commit().await?;
    let rolled_back = answered(second.commit().await);
    Ok(Conflict { clash: clash, later: later, committed: committed, rolled_back: rolled_back })
}

#[test]
async fn two_transactions_on_one_document_conflict() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("two_transactions_on_one_document_conflict");
            assert(cleared(c).await);
            let ada = Aged { name: "Ada", age: 36 };
            assert_eq(inserted(c.insert(ada).await), "no error");
            let ran: Result<Conflict, Error> = two_transactions_on_one_document(db).await;
            match ran {
                Ok(seen) => {
                    assert(seen.clash.contains("(code 112); the transaction hit a temporary conflict; run it again"));
                    assert(!seen.clash.contains("will roll back"));
                    assert_eq(seen.later, "a call in this transaction failed; it will roll back");
                    assert(seen.committed);
                    assert_eq(seen.rolled_back, "the transaction was rolled back: a call in it failed");
                }
                Err(e) => assert_eq(e.message(), "no error"),
            }
            let ada_now: Result<Aged, Error> = c.one("{ name: 'Ada' }").await;
            match ada_now {
                Ok(p) => assert_eq(p.age, 37),
                Err(e) => assert_eq(e.message(), "no error"),
            }
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}

// Reads Ada with `first` inside a transaction of a database connected
// with `url`.
async fn first_in_a_transaction(url: string) -> Result<Option<Aged>, Error> {
    let db = crate::connect(url).await?;
    let mut tx = db.begin().await?;
    let c = tx.collection("a_transaction_reads_from_the_primary_whatever_the_url_says");
    let found: Option<Aged> = c.first("{ name: ? }", "Ada").await?;
    let _done = tx.commit().await?;
    Ok(found)
}

#[test]
async fn a_transaction_reads_from_the_primary_whatever_the_url_says() {
    let opened: Result<crate::Database, Error> = database().await;
    match opened {
        Ok(db) => {
            let c = db.collection("a_transaction_reads_from_the_primary_whatever_the_url_says");
            assert(cleared(c).await);
            let ada = Aged { name: "Ada", age: 36 };
            assert_eq(inserted(c.insert(ada).await), "no error");
            let base = url();
            let preferring = if base.contains("?") {
                format!("{}&readPreference=secondaryPreferred", base)
            } else {
                format!("{}?readPreference=secondaryPreferred", base)
            };
            let found: Result<Option<Aged>, Error> = first_in_a_transaction(preferring).await;
            match found {
                Ok(Some(p)) => assert_eq(p.age, 36),
                Ok(None) => assert(false),
                Err(e) => assert_eq(e.message(), "no error"),
            }
        }
        Err(e) => assert_eq(e.message(), "no error"),
    }
}
